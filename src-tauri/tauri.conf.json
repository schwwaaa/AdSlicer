{
    "$schema": "https://schema.tauri.app/config/2",
    "identifier": "net.schwwaaa.adslicer",
    "productName": "AdSlicerProXP",
    "version": "0.1.0",
    "build": {
        "frontendDist": "../src"
    },
    "app": {
        "withGlobalTauri": true,
        "security": {
            "csp": null
        },
        "windows": [{
            "label": "main",
            "title": "AdSlicer",
            "width": 1100,
            "height": 700
        }]
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.ico",
            "icons/icon_512x512.png"
        ],
        "externalBin": [
            "binaries/ffmpeg",
            "binaries/ffprobe"
        ],
        "resources": {
            "presets/*": "presets"
        }
    },
    "plugins": {}
}